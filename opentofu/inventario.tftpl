[servidores_internos]
web1 ansible_host=${ip_web1} ansible_user=debian
web2 ansible_host=${ip_web2} ansible_user=debian
bd ansible_host=${ip_bd} ansible_user=ubuntu

[servidores_internos:vars]
ansible_ssh_common_args='-o ProxyJump=debian@${ip_balanceador}'

[balanceadores]
balanceador ansible_host=${ip_balanceador} ansible_user=debian

