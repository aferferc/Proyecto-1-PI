<VirtualHost *:80>
    ServerName   {{ item.servername }}
    DocumentRoot {{ item.documentroot }}

    LogFormat "%{X-Forwarded-For}i %l %u %t \"%r\" %>s %O" balanceado
    ErrorLog  ${APACHE_LOG_DIR}/{{ item.nombre }}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ item.nombre }}_access.log balanceado
    
    <Directory {{ item.documentroot }}>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
